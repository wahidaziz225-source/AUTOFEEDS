+"use client";
+
+import { useEffect, useState } from "react";
+import { AlertCircle, CheckCircle2, Loader2, Save } from "lucide-react";
+import { SETTING_FIELDS } from "@/lib/settings-options";
+
+const inputCls =
+  "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900";
+
+export default function SettingsPage() {
+  const [values, setValues] = useState<Record<string, string> | null>(null);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState("");
+  const [saved, setSaved] = useState(false);
+
+  useEffect(() => {
+    (async () => {
+      try {
+        const res = await fetch("/api/settings", { cache: "no-store" });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.error || "Gagal memuat pengaturan.");
+        setValues(data.settings);
+      } catch (e) {
+        setError(e instanceof Error ? e.message : "Gagal memuat pengaturan.");
+      }
+    })();
+  }, []);
+
+  async function save() {
+    if (!values) return;
+    setSaving(true);
+    setError("");
+    setSaved(false);
+    try {
+      const res = await fetch("/api/settings", {
+        method: "PUT",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ settings: values }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error || "Gagal menyimpan pengaturan.");
+      setValues(data.settings);
+      setSaved(true);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Gagal menyimpan pengaturan.");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <div className="mx-auto max-w-2xl space-y-6">
+      <header>
+        <h1 className="text-2xl font-bold text-slate-900">Settings</h1>
+        <p className="text-sm text-slate-500">
+          Pengaturan AI lokal dan unggahan. Disimpan di database komputer ini.
+        </p>
+      </header>
+
+      {error && (
+        <div className="flex items-start gap-2 rounded-xl bg-rose-50 p-4 text-sm text-rose-700 ring-1 ring-rose-200">
+          <AlertCircle size={18} className="mt-0.5 shrink-0" />
+          <span>{error}</span>
+        </div>
+      )}
+
+      {!values && !error && (
+        <div className="flex items-center gap-2 text-sm text-slate-500">
+          <Loader2 size={16} className="animate-spin" /> Memuat pengaturan...
+        </div>
+      )}
+
+      {values && (
+        <div className="space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
+          {SETTING_FIELDS.map((f) => (
+            <label key={f.key} className="block text-sm font-medium text-slate-700">
+              {f.label}
+              {f.kind === "select" ? (
+                <select
+                  className={inputCls}
+                  value={values[f.key] ?? ""}
+                  onChange={(e) => {
+                    setSaved(false);
+                    setValues({ ...values, [f.key]: e.target.value });
+                  }}
+                >
+                  {f.options?.map((o) => (
+                    <option key={o.value} value={o.value}>
+                      {o.label}
+                    </option>
+                  ))}
+                </select>
+              ) : (
+                <input
+                  className={inputCls}
+                  type={f.kind === "number" ? "number" : "text"}
+                  min={f.min}
+                  max={f.max}
+                  value={values[f.key] ?? ""}
+                  onChange={(e) => {
+                    setSaved(false);
+                    setValues({ ...values, [f.key]: e.target.value });
+                  }}
+                />
+              )}
+              <span className="mt-1 block text-xs font-normal text-slate-500">{f.hint}</span>
+            </label>
+          ))}
+
+          <div className="flex items-center gap-3 pt-2">
+            <button
+              type="button"
+              onClick={save}
+              disabled={saving}
+              className="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-60"
+            >
+              {saving ? <Loader2 size={16} className="animate-spin" /> : <Save size={16} />}
+              Simpan
+            </button>
+            {saved && (
+              <span className="inline-flex items-center gap-1 text-sm text-emerald-700">
+                <CheckCircle2 size={16} /> Tersimpan
+              </span>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
