@@ -0,0 +1,97 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import { AlertCircle, Loader2 } from "lucide-react";
+
+type Activity = {
+  id: number;
+  action: string;
+  entity_type: string | null;
+  details: string | null;
+  created_at: string;
+};
+
+const PAGE = 50;
+
+export default function HistoryPage() {
+  const [items, setItems] = useState<Activity[]>([]);
+  const [total, setTotal] = useState(0);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+
+  const load = useCallback(async (offset: number) => {
+    setLoading(true);
+    setError("");
+    try {
+      const res = await fetch(`/api/history?limit=${PAGE}&offset=${offset}`, {
+        cache: "no-store",
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error || "Gagal memuat riwayat.");
+      setTotal(data.total);
+      setItems((prev) => (offset === 0 ? data.activities : [...prev, ...data.activities]));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Gagal memuat riwayat.");
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    load(0);
+  }, [load]);
+
+  return (
+    <div className="mx-auto max-w-3xl space-y-6">
+      <header>
+        <h1 className="text-2xl font-bold text-slate-900">History</h1>
+        <p className="text-sm text-slate-500">
+          Riwayat aktivitas: upload, analisis, konten, dan desain promo.
+        </p>
+      </header>
+
+      {error && (
+        <div className="flex items-start gap-2 rounded-xl bg-rose-50 p-4 text-sm text-rose-700 ring-1 ring-rose-200">
+          <AlertCircle size={18} className="mt-0.5 shrink-0" />
+          <span>{error}</span>
+        </div>
+      )}
+
+      <div className="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
+        {loading && items.length === 0 ? (
+          <div className="flex items-center gap-2 text-sm text-slate-500">
+            <Loader2 size={16} className="animate-spin" /> Memuat riwayat...
+          </div>
+        ) : items.length === 0 && !error ? (
+          <p className="text-sm text-slate-500">
+            Belum ada aktivitas. Mulai dengan mengunggah gambar.
+          </p>
+        ) : (
+          <ul className="divide-y divide-slate-100">
+            {items.map((a) => (
+              <li key={a.id} className="flex items-start justify-between gap-4 py-3 text-sm">
+                <div>
+                  <div className="font-medium text-slate-700">{a.action}</div>
+                  {a.details && <div className="text-slate-500">{a.details}</div>}
+                </div>
+                <span className="shrink-0 text-xs text-slate-400">{a.created_at}</span>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {items.length > 0 && items.length < total && (
+          <button
+            type="button"
+            onClick={() => load(items.length)}
+            disabled={loading}
+            className="mt-4 inline-flex items-center gap-2 rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200 disabled:opacity-60"
+          >
+            {loading && <Loader2 size={14} className="animate-spin" />}
+            Muat lebih banyak ({items.length} dari {total})
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
